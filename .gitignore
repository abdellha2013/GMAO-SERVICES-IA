# ═══════════════════════════════════════════════════════════════════
# Gmao-Services-IA — .gitignore racine (monorepo)
# Couvre le workspace et tous les sous-projets (GMAO-RAG, GMAO-ML, …)
# Pour un nouveau sous-projet : ajouter une section dédiée en bas.
# ═══════════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environment ─────────────────────────────────────────
.venv/
venv/
ENV/

# ── Dépendances / build ────────────────────────────────────────
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Environnement / secrets ────────────────────────────────────
.env
.env.local
.env.*.local
*.env.bak
.env.production
.env.staging
.env.test

# ── Secrets étendus (clés, certificats, tokens) ────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
*.p8
*.ppk
*.asc
secrets/
serverless.yml
*.npmrc
*.pypirc
config/database.yml
id_rsa
id_rsa.pub
.credentials*
*.credentials

# ── IDE / éditeurs ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace

# ── Système ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk

# ── Tests / couverture ─────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ── Type checking / linters ────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ── Logs ───────────────────────────────────────────────────────
*.log
logs/

# ── Fichiers temporaires / backups ─────────────────────────────
tmp/
temp/
uploads/
*.bak
*.tmp

# ═══════════════════════════════════════════════════════════════════
# GMAO-API — passerelle capteurs → ML → Laravel
# ═══════════════════════════════════════════════════════════════════
GMAO-API/static/

# ── Notebooks ──────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Données / artefacts de sortie (tous sous-projets) ──────────
# NB : GMAO-ML/artifacts/*.joblib est volontairement tracké (modèle courant versionné).
*.h5
*.hdf5
*.tf
*.onnx
*.pt
*.ckpt
*.npz
*.npy
*.parquet
*.feather
*.sqlite3
*.db
*.dump
*.bkp
*.7z
*.zip
*.tar.gz
*.tgz

# ── Rapports / exports générés à la volée ─────────────────────
*rapport_maintenance*.md
*rapport_maintenance*.csv
*rapport_maintenance*.html
*.generated.*
/output/
/reports/

# ═══════════════════════════════════════════════════════════════════
# GMAO-ANALYTICS — analytique maintenance (MTBF/MTTR/dispo, port 8300)
# ═══════════════════════════════════════════════════════════════════
GMAO-ANALYTICS/artifacts/
GMAO-ANALYTICS/output/
GMAO-ANALYTICS/*.generated.*

# ═══════════════════════════════════════════════════════════════════
# GMAO-RAG — données volumineuses, Docker et tests hors repo
# ═══════════════════════════════════════════════════════════════════
GMAO-RAG/qdrant_storage/
GMAO-RAG/Dockerfile
GMAO-RAG/docker-compose.yml
GMAO-RAG/.dockerignore
GMAO-RAG/docker/
GMAO-RAG/tests/
GMAO-RAG/app/data_sources/CORRECTIONS_APPLIQUEES.md
GMAO-RAG/app/data_sources/database/AGENT_CONTEXT.md
GMAO-RAG/tmp/data_sources_tmp/database/AGENT_CONTEXT.md

# ═══════════════════════════════════════════════════════════════════
# GMAO-ML — données, modèles, tracking MLflow et tests hors repo
# ═══════════════════════════════════════════════════════════════════
GMAO-ML/data/
GMAO-ML/tests/
GMAO-ML/mlruns/
# GMAO-ML/artifacts/   # volontairement tracké : modèle courant versionné
