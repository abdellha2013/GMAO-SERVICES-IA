# ============================================================
# GMAO-ML — configuration du service ML prédictif
# Copier vers GMAO-ML/.env (jamais commité) :  cp .env.example .env
# ============================================================

# --- API ---
# Clé Bearer pour protéger les endpoints. Vide/absente = auth désactivée (dev).
ML_API_KEY=change-me
ML_API_HOST=127.0.0.1
ML_API_PORT=8100

# --- Artefacts modèles (hors repo, gitignorés) ---
MODEL_DIR=artifacts
MODEL_NAME=gmao_state_classifier
# "latest" ou une version exacte ex: 20260823_151200
MODEL_VERSION=latest

# --- Tracking MLflow ---
# Backend fichier local par défaut ; remplacer par http://... si serveur distant.
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=gmao-ml-etat-machines

# --- Entraînement ---
# Colonne cible dans les CSV d'entraînement.
# AI4I 2020 → "machine_failure" (binaire) ; futur CSV métier → "gravite".
ML_TARGET_COLUMN=machine_failure
ML_TEST_SIZE=0.2
ML_RANDOM_STATE=42
