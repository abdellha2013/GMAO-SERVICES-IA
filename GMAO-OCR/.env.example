# ════════════════════════════════════════════════════
# GMAO-OCR — configuration runtime
# Copier vers .env puis adapter :  cp .env.example .env
# ════════════════════════════════════════════════════

# ── API GMAO-OCR ────────────────────────────────────
OCR_HOST=127.0.0.1
OCR_PORT=8400

# ── API Laravel (fiche équipement) — enrichissement tolérant ─
# Base de l'API Laravel, ex. "https://mondomaine.com".
# Laisser vide pour renvoyer uniquement le lien brut (pas de fiche).
LARAVEL_API_URL=
LARAVEL_TIMEOUT_S=5

# ── Validation anti-phishing de l'URL encodée dans le QR ─
# Hôtes autorisés (séparés par des virgules). Vide = tout hôte valide
# (le chemin /api/equipements/{id} reste exigé).
QR_ALLOWED_HOSTS=

# ── Sécurité du fichier image reçu ──────────────────
OCR_MAX_IMAGE_BYTES=10485760
OCR_DECODE_ATTEMPTS=2
