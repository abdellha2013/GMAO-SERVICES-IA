# ═══════════════════════════════════════════════════════════════════════
# GMAO-OCR ⇄ LARAVEL — configuration d'intégration (racine du projet)
# -----------------------------------------------------------------------
# Fichier pivot unique pour connecter les DEUX services :
#
#   Laravel (backend)  ──(POST /api/v1/qr/scan)──→  GMAO-OCR 10.96.93.45:8400
#   GMAO-OCR ──(GET /api/equipements/{id})──→  Laravel 10.96.93.203:8001
#
#   Machine OCR     : 10.96.93.45  (port 8400)
#   Machine Laravel : 10.96.93.203 (port 8001)
#
# Usage : copier chaque section dans le .env du service correspondant,
#         puis REDÉMARRER le service concerné.
# ═══════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────
# SECTION A — côté LARAVEL (à copier dans le .env de l'app Laravel)
# Ceci permet au backend Laravel d'appeler l'OCR pour scanner les photos.
# ────────────────────────────────────────────────────────────────────────

# URL publique du service OCR dans le réseau local (bind 0.0.0.0 requis)
OCR_BASE_URL=http://10.96.93.45:8400

# Endpoint de scan (multipart "file") et timeout de l'appel
OCR_SCAN_ENDPOINT=/api/v1/qr/scan
OCR_TIMEOUT_S=10
OCR_RETRIES=1

# Format de réponse attendue côté Laravel :
#   success=true
#   id_equipement        identifiant de la fiche
#   lien_equipement      chemin API du backend
#   equipement           fiche détaillée (si le backend est joignable)
#   equipement_details_indisponibles=true  (si backend injoignable)

# Route à exposer pour que l'OCR puisse récupérer la fiche équipement :
#   GET {LARAVEL_API_URL}/api/equipements/{id}  → JSON de la fiche
# (doit renvoyer l'objet équipement, pas du HTML).


# ────────────────────────────────────────────────────────────────────────
# SECTION B — côté GMAO-OCR (à copier dans GMAO-OCR/.env)
# Ceci permet à l'OCR d'enrichir la réponse avec la fiche équipement.
# ────────────────────────────────────────────────────────────────────────

# Base de l'API Laravel (chemin sans slash final)
LARAVEL_API_URL=http://10.96.93.203:8001

# Délai d'attente avant de considérer le backend indisponible (tolérant)
LARAVEL_TIMEOUT_S=5

# Anti-phishing : seuls les QRs pointant vers ce/ces hôtes sont acceptés.
# localhost couvre les QRs générés en dev ; 10.96.93.203 = backend réseau.
# Vide = tout hôte valide (le chemin /api/equipements/{id} reste exigé).
QR_ALLOWED_HOSTS=localhost,10.96.93.203


# ────────────────────────────────────────────────────────────────────────
# Vérification rapide (depuis la machine OCR)
# ────────────────────────────────────────────────────────────────────────
#
# 1. OCR joignable par le réseau :
#    curl http://10.96.93.45:8400/api/v1/healthz
#    → {"status":"ok", ..., "laravel_configured":true}
#
# 2. Laravel joignable par l'OCR :
#    curl http://10.96.93.203:8001/api/equipements/1
#    → JSON de la fiche équipement (ou 404 si id inexistant)
#
# 3. Scan complet (Laravel → OCR) :
#    curl -X POST http://10.96.93.45:8400/api/v1/qr/scan \
#      -H "Content-Type: multipart/form-data" \
#      -F "file=@photo_qr.jpg"
#    → success=true + id_equipement + equipement (fiche enrichie)