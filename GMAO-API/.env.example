# ════════════════════════════════════════════════════
# GMAO-API — configuration runtime
# Copier vers .env puis adapter :  cp .env.example .env
# ════════════════════════════════════════════════════

# ── API GMAO-API ────────────────────────────────────
# Laisser vide = auth désactivée (mode dev, dashboard local).
# Pour activer : GMAO_API_KEY=votre-clé-secrete
GMAO_API_KEY=
API_PORT=8200

# ── Modèle ML (service GMAO-ML) ─────────────────────
ML_API_URL=http://127.0.0.1:8100
ML_API_KEY=gmao-ml-dev-key
ML_TIMEOUT_S=10
ML_RETRIES=2

# ── Backend Laravel ─────────────────────────────────
# true  : aucune requête HTTP, alertes simulées (loggées)
# false : POST réel vers LARAVEL_API_URL + LARAVEL_ALERTS_PATH
SIMULATE_LARAVEL=true
LARAVEL_API_URL=http://127.0.0.1:9000
LARAVEL_ALERTS_PATH=/api/intervention-requests
LARAVEL_IA_USER_ID=1

# ── Base de données (table equipements, lecture seule) ─
# Laisser vide pour utiliser le catalogue Python hardcodé (12 équipements dev).
# Pour le vrai MySQL : mysql+aiomysql://root:MOT_DE_PASSE@127.0.0.1:3306/gmao_rag
EQUIPEMENTS_DB_URL=

# ── Règle d'alerte ──────────────────────────────────
# priorite = critique si P(panne) >= CRITICAL_PROBABILITY, sinon elevee
CRITICAL_PROBABILITY=0.90
