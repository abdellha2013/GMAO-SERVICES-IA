# ════════════════════════════════════════════════════
# GMAO-ANALYTICS — configuration runtime
# Copier vers .env puis adapter :  cp .env.example .env
# ════════════════════════════════════════════════════

# ── API GMAO-ANALYTICS ──────────────────────────────
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=8300

# ── Base de données MySQL (tables de maintenance, lecture seule) ─
# Tables utilisées : pannes, ordre_travails, equipements.
# Laisser vide pour un mode « catalogue » (aucune donnée de maintenance).
MAINTENANCE_DB_URL=mysql+aiomysql://root:MOT_DE_PASSE@127.0.0.1:3306/gmao_rag

# ── Modèle prédictif (GMAO-ML) — enrichissement tolérant ─
ML_API_URL=http://127.0.0.1:8100
ML_TIMEOUT_S=5
ML_RETRIES=1
