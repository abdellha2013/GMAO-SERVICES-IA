# ═══════════════════════════════════════════════════════════════════
# GMAO-RAG — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et remplissez les valeurs réelles :
#   cp .env.example .env
#
# ⚠️ NE JAMAIS commiter le fichier .env contenant vos vrais secrets.
# ═══════════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────
# Chemin absolu vers la racine du projet (requis par certains imports)
PYTHONPATH=/chemin/vers/GMAO-RAG

# ── Qdrant (Base vectorielle) ──────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=gmao_chunks

# ── Embeddings ─────────────────────────────────────────────────
# Device : "auto", "cpu", "cuda"
EMBEDDING_DEVICE=auto
# Modèle multilingue (dimension 384)
EMBEDDING_SMALL_MODEL_NAME=intfloat/multilingual-e5-small
# Révision spécifique du modèle (optionnel)
EMBEDDING_SMALL_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Token HuggingFace (requis si modèle gated, sinon optionnel)
HF_TOKEN=hf_VOTRE_TOKEN

# ── MySQL (Base relationnelle) ─────────────────────────────────
# Option A — DSN complet (priorité la plus haute)
MYSQL_DSN=mysql+pymysql://root:VOTRE_MDP@127.0.0.1:3306/gmao_rag
# Option B — composants séparés (utilisés si MYSQL_DSN absent)
GMAO_DB_HOST=127.0.0.1
GMAO_DB_USER=root
GMAO_DB_PASSWORD=VOTRE_MDP
GMAO_DB_NAME=gmao_rag
GMAO_DB_PORT=3306

# ── LLM principal ─────────────────────────────────────────────
# Stratégie LLM utilisée en premier pour la génération : "gemini" ou "openai"
LLM_STRATEGY=gemini

# ── LLM OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-VOTRE_CLE
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── LLM Gemini (optionnel) ────────────────────────────────────
GEMINI_MODEL_NAME=gemini-3.6-flash
GOOGLE_API_KEY=VOTRE_CLE

# ── Auth API ───────────────────────────────────────────────────
# Token Bearer pour l'authentification de l'API
# Le backend Laravel envoie ce token dans Authorization: Bearer <RAG_API_KEY>
RAG_API_KEY=VOTRE_TOKEN_SECU
